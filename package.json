{
  "name": "tw",
  "version": "0.2.0",
  "description": "Minimal CLI for creating and opening Tailwind CSS playgrounds.",
  "type": "module",
  "bin": {
    "tw": "./bin/tw.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "lint": "oxlint bin lib test",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "check": "npm run lint && npm run format:check && npm run test",
    "prepare": "husky"
  },
  "lint-staged": {
    "bin/**/*.js": [
      "oxlint",
      "oxfmt --write"
    ],
    "lib/**/*.js": [
      "oxlint",
      "oxfmt --write"
    ],
    "test/**/*.js": [
      "oxlint",
      "oxfmt --write"
    ],
    "**/*.{css,html,json,jsonc,md,yaml,yml}": "oxfmt --write"
  },
  "dependencies": {
    "@clack/prompts": "^1.4.0",
    "@fontsource-variable/inter": "^5.2.6",
    "@fontsource-variable/lexend": "^5.2.11",
    "@iconify/json": "^2.2.481",
    "@iconify/tailwind4": "^1.2.3",
    "@tailwindcss/vite": "^4.1.11",
    "tailwindcss": "^4.1.11",
    "vite": "^6.3.5"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "knip": "^6.15.0",
    "lint-staged": "^17.0.7",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.68.0"
  }
}
